# PayU India — Production Configuration
# Get these from https://payu.in merchant dashboard.
# TEST credentials: dashboard "Test" mode. PRODUCTION: after KYC activation.
PAYU_ENV=test
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# Public URLs (no trailing slash). PayU POSTs callbacks to BACKEND_URL/api/payu/callback.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000